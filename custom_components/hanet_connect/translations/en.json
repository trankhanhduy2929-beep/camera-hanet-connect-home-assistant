{
  "title": "HANET Connect",
  "config": {
    "step": {
      "user": {
        "title": "Activate HANET Connect",
        "description": "Installation code: {activation_code}. Enter the HTTPS activation server URL supplied by the seller and your license key. Easy Mode binds the first Home Assistant that uses the key. Only a hash derived from the Home Assistant instance ID is sent; HANET account credentials are never sent to the activation server.",
        "data": {
          "license_server_url": "Activation server URL",
          "license_key": "License key"
        }
      },
      "activation_pending": {
        "title": "Waiting for approval",
        "description": "This server uses manual approval. Installation code: {activation_code}. Send this code to the seller, then select Submit after approval."
      },
      "account": {
        "title": "Sign in to HANET Cloud",
        "description": "Sign in once. Live video connects directly from Home Assistant to each camera over native HANET P2P. Credentials are sent only to HANET Cloud, never to the activation server.",
        "data": {
          "username": "HANET username",
          "password": "HANET password",
          "scan_interval": "Scan interval (seconds)"
        }
      },
      "reconfigure": {
        "title": "Reconfigure HANET Connect",
        "description": "Update the independent HANET account and refresh interval.",
        "data": {
          "username": "HANET username",
          "password": "HANET password",
          "scan_interval": "Scan interval (seconds)"
        }
      },
      "reauth_confirm": {
        "title": "Sign in to HANET Cloud again",
        "description": "HANET Cloud rejected the saved credentials. Enter the current account credentials.",
        "data": {
          "username": "HANET username",
          "password": "HANET password"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect to HANET Cloud.",
      "cannot_connect_license": "Unable to connect to the activation server.",
      "invalid_auth": "The HANET username or password is invalid.",
      "invalid_license": "The license key is invalid.",
      "invalid_license_key": "Enter a valid license key.",
      "invalid_license_response": "The activation server returned an invalid or unsigned license.",
      "invalid_server_url": "Enter a valid HTTPS activation server URL using a hostname.",
      "invalid_url": "Enter a valid HANET Cloud HTTP(S) API URL.",
      "gateway_not_configured": "Enter the HANET Cloud account for this integration.",
      "license_activation_limit": "This license has reached its installation limit.",
      "license_deactivated": "This installation was deactivated.",
      "license_expired": "This license has expired.",
      "license_inactive": "This license is inactive.",
      "license_pending": "The installation is still waiting for seller approval.",
      "license_rejected": "The activation request was rejected.",
      "license_revoked": "This installation was revoked.",
      "unknown": "HANET returned an unexpected response. Check the Home Assistant log."
    },
    "abort": {
      "already_configured": "This HANET account is already configured.",
      "reauth_failed": "The HANET config entry no longer exists.",
      "reauth_successful": "HANET credentials updated successfully.",
      "reconfigure_successful": "HANET account configuration updated.",
      "unique_id_mismatch": "The credentials belong to a different HANET account."
    }
